DirectoryIndex index.php

RewriteEngine On

# Keep catalogs, PHP, and Composer off the public web.
RewriteRule ^(?:app|data|vendor|tests|context|docs|LOOPS|\.agents|\.git)(?:/|$) - [F,L]
RewriteRule ^(?:composer\.(json|lock)|phpunit\.xml|router\.php)$ - [F,L]

# CSS/JS still live under public/assets
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
