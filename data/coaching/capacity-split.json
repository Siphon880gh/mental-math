      "success": {
        "message": "Session complete. Boxes = users ÷ per-box capacity. Cancel zeros.\n\nSAMPLE: 1,000/20=50.",
        "outcome": "success",
        "choices": []
      },
      "start": {
        "message": "SAMPLE: 1,000 simultaneous users, 20 per server. How many boxes?\n\nMove?",
        "outcome": "continue",
        "choices": [
          {
            "id": "div",
            "label": "Users ÷ capacity → 1,000 / 20 = 50",
            "next": "zeros"
          },
          {
            "id": "times",
            "label": "1,000 × 20 = 20,000 servers",
            "next": "wrong_start_times"
          },
          {
            "id": "twenty",
            "label": "20 servers because capacity is 20",
            "next": "wrong_start_twenty"
          }
        ]
      },
      "wrong_start_times": {
        "message": "That explodes the fleet. Divide users by how many each box holds.\n\nReturn to divide.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "start"
      },
      "wrong_start_twenty": {
        "message": "You copied capacity as the fleet size. 1,000/20=50.\n\nReturn to divide.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "start"
      },
      "zeros": {
        "message": "1,000 / 20. Fast cancel?",
        "outcome": "continue",
        "choices": [
          {
            "id": "cancel",
            "label": "1,000 / 20 = 50",
            "next": "check"
          },
          {
            "id": "10",
            "label": "10 — cancelled too far",
            "next": "wrong_zeros_10"
          },
          {
            "id": "2000",
            "label": "2,000 — multiplied after cancelling",
            "next": "wrong_zeros_2000"
          }
        ]
      },
      "wrong_zeros_10": {
        "message": "1,000/20 is 50, not 10.\n\nRevisit the cancel.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "zeros"
      },
      "wrong_zeros_2000": {
        "message": "Stay on divide.\n\nRevisit the cancel.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "zeros"
      },
      "check": {
        "message": "400 users, 20 per box. Fleet?",
