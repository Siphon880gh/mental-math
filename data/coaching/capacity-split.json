        "choices": [
          {
            "id": "twenty_boxes",
            "label": "20 servers",
            "next": "success"
          },
          {
            "id": "400",
            "label": "400 servers",
            "next": "wrong_check_400"
          },
          {
            "id": "8",
            "label": "8 servers",
            "next": "wrong_check_8"
          }
        ]
      },
      "wrong_check_400": {
        "message": "400/20=20.\n\nTry the check again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "check"
      },
      "wrong_check_8": {
        "message": "That would be 400/50. Capacity was 20.\n\nTry the check again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "check"
      }
