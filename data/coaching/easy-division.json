{
  "meta": {
    "slug": "easy-division",
    "title": "Turn division into an easier multiply",
    "summary": "SAMPLE 675÷25: ×4 then two places left → 27. Or factor the divisor; or scale both.",
    "familyId": "easy-division",
    "tags": [
      "beginner"
    ]
  },
  "tree": {
    "start": "start",
    "nodes": {
      "success": {
        "message": "Session complete. Rewrite ÷ as × and a shift; factor; scale both; overshoot or build up; or ask divisor × what.\n\nSAMPLE: 675÷25=27, 936÷12=78, 4.8÷0.06=80, 936÷24=39, 168÷12=14, 861÷21=41.",
        "outcome": "success",
        "choices": []
      },
      "start": {
        "message": "SAMPLE: 675 ÷ 25. Twenty-fives look messy.\n\nRewrite?",
        "outcome": "continue",
        "choices": [
          {
            "id": "times4",
            "label": "×4, then ÷100 → 2,700 → 27",
            "next": "factor"
          },
          {
            "id": "times5",
            "label": "×2 then ÷10, the ÷5 move",
            "next": "wrong_start_times5"
          },
          {
            "id": "long",
            "label": "Long divide 25 into 675",
            "next": "wrong_start_long"
          }
        ]
      },
      "wrong_start_times5": {
        "message": "÷5 is ×2÷10. ÷25 is ×4÷100.\n\nReturn to the rewrite.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "start"
      },
      "wrong_start_long": {
        "message": "Works, but the rewrite is the family. ×4 then two places.\n\nReturn to the rewrite.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "start"
      },
      "factor": {
        "message": "936 ÷ 12. 12 is 3×4. Path?",
        "outcome": "continue",
        "choices": [
          {
            "id": "78",
            "label": "936÷3=312, then ÷4=78",
            "next": "check"
          },
          {
            "id": "times12",
            "label": "936 × 12",
            "next": "wrong_factor_times12"
          },
          {
            "id": "div2",
            "label": "Halve 936 because 12 is even, stop at 468",
            "next": "wrong_factor_div2"
          }
        ]
      },
      "wrong_factor_times12": {
        "message": "That is the product, not the quotient.\n\nRevisit factoring.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "factor"
      },
      "wrong_factor_div2": {
        "message": "One factor of 2 is not ÷12. Need ÷3 and ÷4 (or ÷2 and ÷6).\n\nRevisit factoring.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "factor"
      },
      "check": {
        "message": "4.8 ÷ 0.06. Scale both?",
        "outcome": "continue",
        "choices": [
          {
            "id": "80",
            "label": "×100 → 480 ÷ 6 = 80",
            "next": "partial"
          },
          {
            "id": "8",
            "label": "×10 → 48 ÷ 6 = 8",
            "next": "wrong_check_8"
          },
          {
            "id": "480",
            "label": "480 — scaled the 4.8 and stopped",
            "next": "wrong_check_480"
          }
        ]
      },
      "wrong_check_8": {
        "message": "0.06 needs two places to become 6. Scale both ×100.\n\nTry the check again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "check"
      },
      "wrong_check_480": {
        "message": "You still have to divide by 6.\n\nTry the check again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "check"
      },
      "partial": {
        "message": "SAMPLE: 936 ÷ 24. Partial quotient?",
        "outcome": "continue",
        "choices": [
          {
            "id": "overshoot",
            "label": "24 × 40 = 960, one 24 too many → 39",
            "next": "missing"
          },
          {
            "id": "forty",
            "label": "40, since 960 is close",
            "next": "wrong_partial_forty"
          },
          {
            "id": "long",
            "label": "Long division digit by digit",
            "next": "wrong_partial_long"
          }
        ]
      },
      "wrong_partial_forty": {
        "message": "Close is not done: 960 is one 24 over 936.\n\nTry the partial quotient again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "partial"
      },
      "wrong_partial_long": {
        "message": "Works, slow. Jump to a round multiple and back off.\n\nTry the partial quotient again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "partial"
      },
      "missing": {
        "message": "SAMPLE: 168 ÷ 12. Missing-factor reading?",
        "outcome": "continue",
        "choices": [
          {
            "id": "times_what",
            "label": "12 × what = 168? 12 × 14 → 14",
            "next": "buildup"
          },
          {
            "id": "divide_cols",
            "label": "Long division 168 ÷ 12",
            "next": "wrong_missing_divide_cols"
          },
          {
            "id": "times",
            "label": "168 × 12",
            "next": "wrong_missing_times"
          }
        ]
      },
      "wrong_missing_divide_cols": {
        "message": "Works, slow. If you know 12 × 14, you are done.\n\nReturn to the missing factor.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "missing"
      },
      "wrong_missing_times": {
        "message": "That multiplies. Ask 12 × ? = 168.\n\nReturn to the missing factor.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "missing"
      },
      "buildup": {
        "message": "SAMPLE: 861 ÷ 21. Build up with partial quotients?",
        "outcome": "continue",
        "choices": [
          {
            "id": "forty_one",
            "label": "21 × 40 = 840, 21 left = one more 21 → 41",
            "next": "success"
          },
          {
            "id": "forty",
            "label": "40, the remainder does not matter",
            "next": "wrong_buildup_forty"
          },
          {
            "id": "forty_two",
            "label": "21 × 42 = 861",
            "next": "wrong_buildup_forty_two"
          }
        ]
      },
      "wrong_buildup_forty": {
        "message": "861 − 840 = 21 is one more copy of 21. Answer 41.\n\nTry the build-up again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "buildup"
      },
      "wrong_buildup_forty_two": {
        "message": "21 × 42 = 882. One copy too many.\n\nTry the build-up again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "buildup"
      }
    }
  }
}
