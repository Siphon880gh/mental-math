{
  "meta": {
    "slug": "fixed-multipliers",
    "title": "Fixed multipliers",
    "summary": "SAMPLE 42 × 19: ×20 minus one copy → 798. Each multiplier is a double, a shift, or one copy off.",
    "familyId": "fixed-multipliers",
    "tags": [
      "beginner"
    ]
  },
  "tree": {
    "start": "start",
    "nodes": {
      "success": {
        "message": "Session complete. Neighbors of round numbers add or remove one copy; ×6, ×12, ×15 are small builds. The Trachtenberg digit rules do the same rows one digit at a time, right to left.\n\nSAMPLE: 42×19=798, 43×6=258, 46×15=690, 38×1,001=38,038, 263×12=3,156, 524×6=3,144.",
        "outcome": "success",
        "choices": []
      },
      "start": {
        "message": "SAMPLE: 42 seats at $19 each. Which shape is ×19?",
        "outcome": "continue",
        "choices": [
          {
            "id": "round_minus",
            "label": "×20, then minus one 42 → 840 − 42 = 798",
            "next": "sixes"
          },
          {
            "id": "ten_nine",
            "label": "×10 plus ×9 by columns",
            "next": "wrong_start_ten_nine"
          },
          {
            "id": "round_plus",
            "label": "×20, then plus 42",
            "next": "wrong_start_round_plus"
          }
        ]
      },
      "wrong_start_ten_nine": {
        "message": "Works, but two partial products. 19 is one copy below 20.\n\nReturn to the neighbor.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "start"
      },
      "wrong_start_round_plus": {
        "message": "×19 is one copy fewer than ×20, so subtract.\n\nReturn to the neighbor.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "start"
      },
      "sixes": {
        "message": "SAMPLE: 43 × 6. Fastest build?",
        "outcome": "continue",
        "choices": [
          {
            "id": "five_plus",
            "label": "×5 is 215, plus one 43 → 258",
            "next": "fifteen"
          },
          {
            "id": "double_triple",
            "label": "Double three times",
            "next": "wrong_sixes_double_triple"
          },
          {
            "id": "ten_minus",
            "label": "×10 minus 43",
            "next": "wrong_sixes_ten_minus"
          }
        ]
      },
      "wrong_sixes_double_triple": {
        "message": "Three doubles is ×8, not ×6.\n\nRevisit ×6.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "sixes"
      },
      "wrong_sixes_ten_minus": {
        "message": "×10 − ×1 is ×9. ×6 is ×5 + ×1.\n\nRevisit ×6.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "sixes"
      },
      "fifteen": {
        "message": "SAMPLE: 46 × 15. Build?",
        "outcome": "continue",
        "choices": [
          {
            "id": "ten_half",
            "label": "×10 = 460, plus half of that 230 → 690",
            "next": "big"
          },
          {
            "id": "fifteen_cols",
            "label": "Write 46 × 15 in columns",
            "next": "wrong_fifteen_fifteen_cols"
          },
          {
            "id": "ten_plus_five",
            "label": "460 + 5 = 465",
            "next": "wrong_fifteen_ten_plus_five"
          }
        ]
      },
      "wrong_fifteen_fifteen_cols": {
        "message": "Slow. ×15 is ×10 plus half of ×10.\n\nTry ×15 again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "fifteen"
      },
      "wrong_fifteen_ten_plus_five": {
        "message": "Add ×5 of 46 (230), not the digit 5.\n\nTry ×15 again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "fifteen"
      },
      "big": {
        "message": "SAMPLE: 38 × 1,001. What happens?",
        "outcome": "continue",
        "choices": [
          {
            "id": "park",
            "label": "38,000 + 38 → 38,038 (the number twice)",
            "next": "trach12"
          },
          {
            "id": "times_thousand",
            "label": "38,000 and stop",
            "next": "wrong_big_times_thousand"
          },
          {
            "id": "minus",
            "label": "38,000 − 38",
            "next": "wrong_big_minus"
          }
        ]
      },
      "wrong_big_times_thousand": {
        "message": "×1,001 is ×1,000 plus one more copy.\n\nTry ×1,001 again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "big"
      },
      "wrong_big_minus": {
        "message": "That is ×999. ×1,001 adds the copy.\n\nTry ×1,001 again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "big"
      },
      "trach12": {
        "message": "SAMPLE: Trachtenberg ×12 on 263, written 0263. Start at the right: digit 3, neighbor 0. What goes down?",
        "outcome": "continue",
        "choices": [
          {
            "id": "double_plus",
            "label": "2 × 3 + 0 = 6. Write 6",
            "next": "trach12b"
          },
          {
            "id": "eleven_rule",
            "label": "3 + 0 = 3",
            "next": "wrong_trach12_eleven_rule"
          },
          {
            "id": "whole",
            "label": "3 × 12 = 36. Write 36",
            "next": "wrong_trach12_whole"
          }
        ]
      },
      "wrong_trach12_eleven_rule": {
        "message": "That is the ×11 rule. ×12 doubles the digit first: 2 × 3 + 0 = 6.\n\nBack to the first digit.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "trach12"
      },
      "wrong_trach12_whole": {
        "message": "One digit per step. Double plus neighbor is 6, and nothing carries yet.\n\nBack to the first digit.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "trach12"
      },
      "trach12b": {
        "message": "Next: digit 6, neighbor 3. 2 × 6 + 3 = 15. What do you write?",
        "outcome": "continue",
        "choices": [
          {
            "id": "carry",
            "label": "Write 5, carry 1. The answer finishes as 3,156",
            "next": "trach6"
          },
          {
            "id": "write15",
            "label": "Write 15",
            "next": "wrong_trach12b_write15"
          },
          {
            "id": "swap",
            "label": "Write 1, carry 5",
            "next": "wrong_trach12b_swap"
          }
        ]
      },
      "wrong_trach12b_write15": {
        "message": "Each step writes one digit. Write 5 and carry the 1 left.\n\nTry the carry again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "trach12b"
      },
      "wrong_trach12b_swap": {
        "message": "The ones digit stays; the tens digit carries. Write 5, carry 1.\n\nTry the carry again.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "trach12b"
      },
      "trach6": {
        "message": "SAMPLE: Trachtenberg ×6 on 524. Middle digit 2, neighbor 4. What goes down?",
        "outcome": "continue",
        "choices": [
          {
            "id": "half",
            "label": "2 + half of 4 = 4. 2 is even, so no +5",
            "next": "success"
          },
          {
            "id": "whole_nb",
            "label": "2 + 4 = 6",
            "next": "wrong_trach6_whole_nb"
          },
          {
            "id": "plus5",
            "label": "2 + 2 + 5 = 9",
            "next": "wrong_trach6_plus5"
          }
        ]
      },
      "wrong_trach6_whole_nb": {
        "message": "×6 takes half the neighbor, not all of it: 2 + 2 = 4.\n\nBack to the ×6 digit.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "trach6"
      },
      "wrong_trach6_plus5": {
        "message": "The +5 is only for odd digits. 2 is even, so 4.\n\nBack to the ×6 digit.",
        "outcome": "wrong",
        "choices": [],
        "rewind_to": "trach6"
      }
    }
  }
