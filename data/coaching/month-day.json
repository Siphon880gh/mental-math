        "message": "Session complete. Monthly ÷ 30 ≈ daily; daily × 30 ≈ monthly.\n\nSAMPLE: $900/mo→$30/day, $20/day→$600/mo.",
        "outcome": "success",
        "choices": []
      },
      "start": {
        "message": "SAMPLE: $900 per month server bill. Someone asks the daily burn.\n\nWhich move?",
        "outcome": "continue",
        "choices": [
          {
            "id": "div30",
            "label": "÷30",
            "next": "apply"
          },
          {
            "id": "div7",
            "label": "÷7 because a week has seven days",
            "next": "wrong_start_div7"
          },
          {
            "id": "div720",
            "label": "÷720 — that is monthly back to hourly",
            "next": "wrong_start_div720"
          }
        ]
      },
      "wrong_start_div7": {
        "message": "Weekly would be ÷4-ish from monthly, not ÷7 from monthly. Daily is ÷30.\n\nReturn to the constant.",
