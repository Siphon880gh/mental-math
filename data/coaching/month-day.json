        "choices": [],
        "rewind_to": "start"
      },
      "apply": {
        "message": "900 ÷ 30.\n\nDaily?",
        "outcome": "continue",
        "choices": [
          {
            "id": "30",
            "label": "$30/day",
            "next": "check"
          },
          {
            "id": "3",
            "label": "$3/day — extra zero dropped",
            "next": "wrong_apply_3"
          },
          {
            "id": "90",
            "label": "$90/day — ÷10",
            "next": "wrong_apply_90"
          }
        ]
      },
      "wrong_apply_3": {
        "message": "900÷30=30, not 3.\n\nRevisit the divide.",
        "outcome": "wrong",
        "choices": [],
